# Proveedor de LLM a usar: "openai", "anthropic" u "openrouter"
LLM_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- OpenRouter (opcional, proxy OpenAI-compatible a multiples modelos) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- App ---
APP_NAME=
APP_ENV=

# --- Sesiones conversacionales ---
# Numero maximo de turnos (pares user+assistant) en la ventana deslizante.
SESSION_MAX_TURNS=
# Maximo de caracteres de texto extraido por adjunto (Camino B).
ATTACHMENT_MAX_CHARS=
