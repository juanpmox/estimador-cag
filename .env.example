# ---------------------------------------------------------------------------
# Copia este archivo a .env y completá sólo lo que necesites:
#
#     cp .env.example .env
#
# .env está en .gitignore y NUNCA debe subirse al repositorio.
#
# Las variables comentadas heredan el default de app/config.py: si las
# descomentás, tienen que llevar un VALOR VALIDO (una variable vacía como
# `LLM_PROVIDER=` rompe el arranque con un ValidationError de pydantic).
#
# Ojo: pydantic-settings lee el .env al ARRANCAR el proceso y get_settings()
# está memoizado con lru_cache. Si editás el .env con el servicio corriendo,
# reinicialo para que lo relea.
# ---------------------------------------------------------------------------

# Proveedor a usar: "openai", "anthropic" u "openrouter".
# Elegí uno y completá su API key más abajo.
LLM_PROVIDER=anthropic

# --- OpenAI ---
# Necesario si LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# Necesario si LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenRouter (proxy OpenAI-compatible a multiples modelos: una sola key) ---
# Necesario si LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Opcionales, recomendados por OpenRouter para rankings/analytics.
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=

# --- App ---
# APP_NAME=Estimador CAG
# APP_ENV=development

# --- Sesiones conversacionales ---
# Turnos (pares user+assistant) que conserva la ventana deslizante del historial.
# SESSION_MAX_TURNS=6
# Máximo de caracteres de texto extraído por adjunto (Camino B).
# ATTACHMENT_MAX_CHARS=20000

# --- Cliente (Streamlit) ---
# URL base del servicio IA. Sólo hace falta si el cliente no corre en localhost.
# API_BASE_URL=http://localhost:8000
